<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>

    <!-- Passa respostas de erro do Node.js sem interceptar -->
    <httpErrors existingResponse="PassThrough" />

    <rewrite>
      <rules>

        <!-- Regra 1a: Auth.js -> Next.js (porta 3000) — deve vir ANTES da regra de API -->
        <rule name="Auth - Next.js" stopProcessing="true">
          <match url="^api/auth(.*)" ignoreCase="true" />
          <action type="Rewrite"
                  url="http://127.0.0.1:3000/api/auth{R:1}"
                  appendQueryString="true" />
        </rule>

        <!-- Regra 1b: API -> Backend Fastify (porta 3333) -->
        <rule name="API - Backend Proxy" stopProcessing="true">
          <match url="^api/(.*)" ignoreCase="true" />
          <action type="Rewrite"
                  url="http://127.0.0.1:3333/api/{R:1}"
                  appendQueryString="true" />
        </rule>

        <!-- Regra 2: Arquivos estaticos do Next.js servidos direto pelo IIS -->
        <rule name="NextStaticFiles" stopProcessing="true">
          <match url="^_next/static/(.*)" />
          <action type="None" />
        </rule>

        <!-- Regra 3: Tudo mais -> Frontend Next.js (porta 3000) -->
        <rule name="Frontend - Next.js Proxy" stopProcessing="true">
          <match url="^(.*)" />
          <action type="Rewrite"
                  url="http://127.0.0.1:3000/{R:0}"
                  appendQueryString="true" />
        </rule>

      </rules>
    </rewrite>

  </system.webServer>
</configuration>
